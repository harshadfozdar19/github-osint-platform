# =============================================================================
# Root / shared environment template
# Copy to apps/api/.env and apps/web/.env.local as needed.
# NEVER commit real secrets.
# =============================================================================

# ----- Backend (apps/api/.env) -----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/github-osint
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Optional. Without this token the API still boots; scans use seed/demo mode.
# Workspaces can also supply their own token from the UI (Settings), which
# takes priority for that workspace's scans — this is the shared fallback.
GITHUB_TOKEN=

# Required only if you use per-workspace GitHub tokens (Settings page).
# Long random string, e.g. `openssl rand -hex 32`. Never rotate this without
# a migration plan — existing encrypted tokens become unreadable if it changes.
TOKEN_ENCRYPTION_KEY=

# Repos discovered/analyzed per scan (checkpointed + resumable). Push toward
# 5000 once GITHUB_WORKSPACE_DAILY_BUDGET and GITHUB_TOKEN quota can absorb it.
SCAN_MAX_REPOS=1000
SCAN_MAX_QUERIES=40
# Files fetched per repo for content analysis (README, .env, credential-like paths)
SCAN_MAX_FILES_PER_REPO=12
# Repos per GitHub search API page (GitHub's own max is 100; costs the same
# 1 request regardless of page size, so keep this high).
SEARCH_BATCH_SIZE=100
SCAN_OWNER_FANOUT_LIMIT=5
SCAN_FORK_WALK_LIMIT=5
# Code search finds filename/secret leaks (uses /search/code; stricter quota)
ENABLE_CODE_SEARCH=true
GITHUB_MAX_FILE_BYTES=51200

# Demo data seeding (local dev only). When true, both SEED_DEMO_EMAIL and
# SEED_DEMO_PASSWORD must also be set below, or seeding is skipped with a
# warning. Never commit real values for these two — keep them in your local
# .env only (already gitignored).
SEED_ON_BOOT=false
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=

# Auto-learn keywords from confirmed Critical/High findings (pure DB feedback
# loop, no extra GitHub calls). Default on.
AUTO_PROMOTE_KEYWORDS=true

# Scan recent commit diffs (not just current HEAD) for secrets that were
# committed and later removed. Off by default: costs ~1 + N GitHub requests
# per brand-matched repo (a commits list call plus one per commit inspected).
ENABLE_GIT_HISTORY_SCAN=false
GIT_HISTORY_MAX_COMMITS=15

# Shallow git clone + local scan instead of per-file REST fetches. Full-repo
# coverage (not just a priority-file list) with near-zero GitHub API cost -
# git clone uses git's own transport, not the rate-limited REST API. Off by
# default: costs disk/CPU instead of API quota, so it's opt-in.
ENABLE_CLONE_SCAN=false
# Skip cloning (fall back to REST fetch) above this repo size (KB).
CLONE_SCAN_MAX_REPO_SIZE_KB=51200
# Abort a clone that takes longer than this.
CLONE_SCAN_TIMEOUT_MS=30000
# Max files to read content from per clone (cheap since it's local disk, not API calls).
CLONE_SCAN_MAX_FILES=200

# Multi-tenancy: clients must send X-Workspace-Id on tenant-scoped routes.

# ----- Redis / BullMQ (required for asynchronous scans) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional full URL (overrides host/port when set)
# REDIS_URL=redis://localhost:6379

# When true, the API process also runs queue workers (convenient for local dev).
# In production set false on the API and run `npm run start:worker` separately.
ENABLE_QUEUE_WORKERS=true

WORKER_CONCURRENCY_ORCHESTRATOR=2
WORKER_CONCURRENCY_GITHUB_SEARCH=2
WORKER_CONCURRENCY_REPO_ANALYSIS=3
WORKER_CONCURRENCY_DETECTION=3
WORKER_CONCURRENCY_ALERT=5

QUEUE_JOB_ATTEMPTS=3
QUEUE_BACKOFF_MS=2000
QUEUE_JOB_TIMEOUT_MS=120000
# How often each of the 5 always-on workers scans for stalled jobs, and how
# long it blocks before re-polling an empty queue. BullMQ's defaults (30s /
# 5s) are tuned for high-throughput queues; widened here since this app has
# low traffic and idle-worker background chatter is the main driver of
# Redis command volume on a metered/free Redis plan (e.g. Upstash).
QUEUE_STALLED_INTERVAL_MS=120000
QUEUE_DRAIN_DELAY_MS=15000

# Scan progress SSE / polling (ms between non-terminal progress publishes)
SCAN_PROGRESS_THROTTLE_MS=500

# ----- GitHub rate-limit management -----
GITHUB_REQUEST_TIMEOUT_MS=15000
GITHUB_RETRY_ATTEMPTS=3
GITHUB_RETRY_BACKOFF_MS=500
GITHUB_RETRY_BACKOFF_MAX_MS=20000
# Warn in dashboard when remaining <= this
GITHUB_RATE_LIMIT_LOW=20
# Pause shared workers when remaining <= this
GITHUB_RATE_LIMIT_PAUSE_AT=5
# Per-workspace daily request budget (prevents one tenant starving others).
# Sized to comfortably cover a SCAN_MAX_REPOS=1000 scan (~2-3 requests/repo
# plus search queries); raise further if you push SCAN_MAX_REPOS toward 5000.
GITHUB_WORKSPACE_DAILY_BUDGET=5000
GITHUB_WORKSPACE_MAX_CONCURRENCY=2
GITHUB_GLOBAL_MAX_CONCURRENCY=10
# Inline wait before delaying BullMQ jobs
GITHUB_MAX_INLINE_WAIT_MS=15000

# ----- Frontend (apps/web/.env.local) -----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
